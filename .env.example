# ============================================================
# LLM 配置（可选）
# - 不配置也能跑完整核对：OCR、Excel 读取、匹配、异常检测、报告全是纯 Python 规则
# - 配置 API Key 后，勾选「启用 LLM 异常解释」，LLM 只对异常写 1-2 句中文解读
#   （不参与任何金额计算或核对决策）
# ============================================================

# ---- 方案 A：OpenAI 官方（默认）----
OPENAI_API_KEY=sk-你的OpenAIKey
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- 方案 B：DeepSeek（推荐，国内直连、便宜）----
# 把上面三行换成下面这三行即可，代码一行都不用改：
# OPENAI_API_KEY=sk-你的DeepSeekKey
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ---- 方案 C：通义千问 / 其他 OpenAI 兼容服务 ----
# 只需改 OPENAI_BASE_URL 与 LLM_MODEL 为对应地址和模型名，
# 因为本项目用的是「OpenAI 兼容协议」，任意兼容服务都能接。
