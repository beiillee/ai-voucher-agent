# Python
__pycache__/
*.py[cod]
*.pyo
.Python

# 虚拟环境
.venv/
venv/
env/

# 环境变量 / 密钥（切勿提交）
.env
.env.local

# OCR / 解析缓存（可重新生成，体积大）
data/ocr_cache*.json
data/pages/
output/cache/
# 注意：不要在这里写 pages/ —— Streamlit 的多页面目录就叫 pages/，
# 忽略掉会导致页面代码无法提交。

# 临时图片
*.png
*.jpeg
*.jpg

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store

# 评估 / 压测的临时中间产物（正式报告 output/evaluation/ 保留并提交）
output/_eval/
output/_perf*/

# 网页上传与运行产物
output/web/
output/uploads/
