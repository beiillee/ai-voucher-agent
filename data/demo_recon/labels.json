  "known_gaps": [
    {
      "case": "同号重复凭证（DUPLICATE_LEDGER / DUPLICATE_VOUCHER）",
      "status": "已修复（阶段1）",
      "reason": "excel_analyzer._aggregate_vouchers 与 voucher_extractor.extract_vouchers 都按凭证号分组，同号记录在聚合阶段已被合并为一张凭证，因此 anomaly_detector 里基于 Counter 的重复检测永远得到计数 1。",
      "suggested_fix": "P3 阶段在 records 层（聚合前）扫描重复凭证号，或在聚合时保留重复组标记。",
      "fix_note": "reconciliation._build_ledger_index 的 by_key 改为挂列表，同号凭证全部保留；reconcile 在 records 层按凭证号扫描重复组，输出 duplicates.ledger / duplicates.pdf。"
    },
    {
      "case": "reconciliation.summary 缺 DATE_MISMATCH 计数",
      "status": "已修复（阶段1）",
      "reason": "summary 只统计 matched / amount_mismatch / pdf_only / ocr_uncertain，日期不一致只能从 pairs 或 anomalies 反查。",
      "suggested_fix": "P2 阶段在 summary 中补 date_mismatch 字段。",
      "fix_note": "summary 增加 date_mismatch / suspected / strict_match_rate_pct。"
    }
  ],
